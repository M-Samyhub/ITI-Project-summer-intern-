@using ItiFinalProject.View_Model.Category
@model UpdateCategoryViewModel

<div class="container mt-4">
    <h1>Edit on Category</h1>

    <form asp-controller="Category" asp-action="Edit" method="post">
        <div class="mb-3">
            <label asp-for="Name" class="form-label">Category Name</label>
            <input asp-for="Name" type="text" class="form-control">
        </div>
        <div class="mb-3">
            <label asp-for="Description" class="form-label">Description</label>
            <input asp-for="Description" type="text" class="form-control">
        </div>
        <button type="submit" class="btn btn-primary">Submit</button>
        <a asp-action="Index"  class="btn btn-secondary">Back</a>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}