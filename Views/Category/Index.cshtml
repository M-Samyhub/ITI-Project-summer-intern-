@using ItiFinalProject.View_Model.Category
@model IEnumerable<CategoryViewModel>

@{
    ViewData["Title"] = "Category List";
}

<div class="container mt-4 mb-5">
    <!-- Header Section -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="fw-bold text-dark m-0">Category Management</h2>
            <p class="text-muted small mb-0">Add, edit, or delete product categories.</p>
        </div>
        <a asp-action="Create" class="btn btn-primary px-4 py-2 rounded-3 fw-semibold shadow-sm">
            <i class="bi bi-plus-lg me-1"></i> Add new category
        </a>
    </div>

    <!-- Filter and Table Section -->
    <div class="card border-0 shadow-sm rounded-4 overflow-hidden mb-4">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead style="background-color: #007bff; color: white;">
                    <tr>
                        <th class="ps-4" style="width: 10%;">ID</th>
                        <th style="width: 25%;">Category Name</th>
                        <th style="width: 35%;">Description</th>
                        <th style="width: 15%;">Product Count</th>
                        <th class="text-center pe-4" style="width: 15%;">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @if (!Model.Any())
                    {
                        <tr>
                            <td colspan="5" class="text-center text-muted py-5">
                                <i class="bi bi-folder-x fs-1 d-block mb-2 text-secondary"></i>
                                No categories have been added yet.
                            </td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td class="ps-4 fw-bold text-secondary">#@item.Id</td>
                                <td class="fw-semibold text-dark">@item.Name</td>
                                <td class="text-muted small text-truncate" style="max-width: 300px;" title="@item.Description">
                                    @(string.IsNullOrEmpty(item.Description) ? "No description available" : item.Description)
                                </td>
                                <td>
                                    <span class="badge rounded-pill bg-info-subtle text-info border border-info-subtle px-3 py-1 fw-semibold">
                                        @item.ProductCount Products
                                    </span>
                                </td>
                                <td class="text-center pe-4">
                                    <div class="btn-group" role="group">
                                        <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-outline-info rounded-start-2">Details</a>
                                        <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-outline-warning">Edit</a>
                                        <form asp-action="Delete" asp-route-id="@item.Id" method="post" class="d-inline" onsubmit="return confirm('Are you sure you want to delete this category?');">
                                            <button type="submit" class="btn btn-sm btn-outline-danger rounded-end-2">Delete</button>
                                        </form>
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>