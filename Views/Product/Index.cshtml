@using ItiFinalProject.View_Model.Product
@model IEnumerable<ProductViewModel>
@{
    ViewData["Title"] = "Product List";
}

<div class="container mt-4 mb-5">
    <!-- Header Section -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="fw-bold text-dark m-0">Product Management</h2>
            <p class="text-muted small mb-0">Manage, edit and organize your store products.</p>
        </div>
        <a asp-action="Create" class="btn btn-primary px-4 py-2 rounded-3 fw-semibold shadow-sm">
            <i class="bi bi-plus-lg me-1"></i> Add new Product
        </a>
    </div>

    <!-- Table Section -->
    <div class="card border-0 shadow-sm rounded-4 overflow-hidden">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead style="background-color: #007bff; color: white;">
                    <tr>
                        <th class="ps-4">ID</th>
                        <th>Product Name</th>
                        <th>Price</th>
                        <th style="width: 25%;">Description</th>
                        <th>Quantity</th>
                        <th>Category</th>
                        <th>Image</th>
                        <th class="text-center pe-4">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @if (!Model.Any())
                    {
                        <tr>
                            <td colspan="8" class="text-center text-muted py-5">
                                <i class="bi bi-inbox fs-1 d-block mb-2 text-secondary"></i>
                                No products have been added yet.
                            </td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td class="ps-4 fw-bold text-secondary">#@item.Id</td>
                                <td class="fw-semibold text-dark">@item.Title</td>
                                <td>
                                    <span class="badge bg-success-subtle text-success border border-success-subtle px-2 py-1 fs-6">
                                        $@item.Price
                                    </span>
                                </td>
                                <td class="text-muted small text-truncate" style="max-width: 200px;" title="@item.Description">
                                    @item.Description
                                </td>
                                <td>
                                    <span class="badge rounded-pill bg-light text-dark border px-3 py-1">
                                        @item.Quantity
                                    </span>
                                </td>
                                <td>
                                    <span class="badge bg-primary-subtle text-primary fw-medium px-2.5 py-1">
                                        @item.CategoryName
                                    </span>
                                </td>
                                <td>
                                    @if (!string.IsNullOrEmpty(item.ImgePath))
                                    {
                                        <img src="~/images/products/@System.IO.Path.GetFileName(item.ImgePath)"
                                             asp-append-version="true"
                                             alt="@item.Title"
                                             style="width: 48px; height: 48px; object-fit: cover;"
                                             class="rounded-3 border shadow-sm" />
                                    }
                                    else
                                    {
                                        <div class="bg-light rounded-3 border d-flex align-items-center justify-content-center text-muted small" style="width: 48px; height: 48px;">
                                            No Img
                                        </div>
                                    }
                                </td>
                                <td class="text-center pe-4">
                                    <div class="btn-group" role="group">
                                        <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-outline-info rounded-start-2">Details</a>
                                        <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-outline-warning">Edit</a>
                                        <form asp-action="Delete" asp-route-id="@item.Id" method="post" class="d-inline" onsubmit="return confirm('Are you sure you want to delete this product?');">
                                            <button type="submit" class="btn btn-sm btn-outline-danger rounded-end-2">Delete</button>
                                        </form>
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>