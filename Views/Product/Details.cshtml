@using ItiFinalProject.View_Model.Product
@model ProductViewModel
@{
    ViewData["Title"] = "Product";
}

<div class="container mt-4">

    <table class="table table-striped table-hover align-middle">
        <thead class="table-info">
            <tr>
                <th>Product Info</th>

            </tr>
        </thead>
        <tbody>
            <tr class="table-warning"><td>ID: @Model.Id</td></tr>
            <tr class="table-warning"><td>Name: @Model.Title</td></tr>
            <tr class="table-warning"><td>Price: @Model.Price</td></tr>
            <tr class="table-warning"><td>Description: @Model.Description</td></tr>
            <tr class="table-warning"><td>Category: @Model.CategoryName</td></tr>
            <tr class="table-warning"><td>Quantity: @Model.Quantity</td></tr>
            <tr class="table-warning">
                <td>
                    <div class="mb-3">
                        <label class="form-label fw-bold">صورة المنتج:</label>
                        <div>
                            @if (!string.IsNullOrEmpty(Model.ImgePath))
                            {
                                <img src="~/images/products/@System.IO.Path.GetFileName(Model.ImgePath)"
                                     asp-append-version="true"
                                     alt="@Model.Title"
                                     class="img-fluid rounded border shadow-sm"
                                     style="max-width: 300px; maxHeight: 300px; object-fit: cover;" />
                            }
                            else
                            {
                                <div class="alert alert-secondary d-inline-block">
                                    لا توجد صورة لهذا المنتج
                                </div>
                            }
                        </div>
                    </div>
                </td>
            </tr>
        </tbody>
    </table>
    <div class="d-flex justify-content-between align-items-center mb-3">
        <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-warning">
            Edit Product
        </a>
        <a asp-action="Index" class="btn btn-secondary">
            Back
        </a>
    </div>
</div>