@* ======================================================= *@

<style>
    body {
        background-color: #f8f9fa;
    }

    .brand-logo-icon {
        color: #1f2d42;
        font-size: 2rem;
    }

    .custom-card {
        border-radius: 12px;
        box-shadow: 0 10px 30px rgba(0, 0, 0, 0.08);
        border: 1px solid #e9ecef;
    }

    .custom-card-header {
        background-color: #1f2d42 !important;
        color: #ffffff;
        padding: 1.25rem;
        font-size: 1.25rem;
        font-weight: 600;
        border-top-left-radius: 12px !important;
        border-top-right-radius: 12px !important;
    }

    .btn-dark-navy {
        background-color: #1f2d42;
        color: #ffffff;
        border: none;
        padding: 0.6rem 1rem;
        font-weight: 500;
        transition: background-color 0.2s ease-in-out;
    }

        .btn-dark-navy:hover {
            background-color: #152030;
            color: #ffffff;
        }

    .input-group-text {
        background-color: #ffffff;
        border-right: none;
        color: #6c757d;
    }

    .form-control-custom {
        border-left: none;
        padding-left: 0;
    }

        .form-control-custom:focus {
            box-shadow: none;
            border-color: #ced4da;
        }

    .divider-text {
        position: relative;
        text-align: center;
        margin: 1.5rem 0;
    }

        .divider-text::before {
            content: "";
            position: absolute;
            top: 50%;
            left: 0;
            right: 0;
            height: 1px;
            background-color: #e0e0e0;
            z-index: 1;
        }

        .divider-text span {
            background-color: #ffffff;
            padding: 0 10px;
            position: relative;
            z-index: 2;
            color: #8c8c8c;
            font-size: 0.8rem;
            font-weight: 600;
        }
</style>

<div class="row justify-content-center align-items-center my-5">
    <div class="col-md-5 col-lg-4">

        <!-- Header Brand Icon & Name -->
        <div class="text-center mb-4">
            <div class="d-inline-flex align-items-center justify-content-center mb-1">
                <i class="bi bi-cart3 brand-logo-icon me-2"></i>
                <span class="fs-3 fw-bold" style="color: #1f2d42;">StoreOps</span>
            </div>
        </div>

        <!-- Main Login Card -->
        <div class="card custom-card border-0">
            <div class="custom-card-header text-center">
                Log in to your StoreOps Account
            </div>

            <div class="card-body p-4 bg-white">
                <form asp-action="Login" method="post">
                    <div asp-validation-summary="ModelOnly" class="text-danger small mb-3"></div>

                    <!-- Username / Email Field -->
                    <div class="mb-3">
                        <label asp-for="Email" class="form-label fw-semibold text-dark small mb-1">Username or Email Address</label>
                        <div class="input-group">
                            <span class="input-group-text">
                                <i class="bi bi-envelope"></i>
                            </span>
                            <input asp-for="Email" class="form-control form-control-custom" />
                        </div>
                        <span asp-validation-for="Email" class="text-danger small"></span>
                    </div>

                    <!-- Password Field -->
                    <div class="mb-3">
                        <label asp-for="Password" class="form-label fw-semibold text-dark small mb-1">Password</label>
                        <div class="input-group">
                            <span class="input-group-text">
                                <i class="bi bi-lock"></i>
                            </span>
                            <input asp-for="Password" type="password" class="form-control form-control-custom" />
                        </div>
                        <span asp-validation-for="Password" class="text-danger small"></span>
                    </div>

                    <!-- Remember Me -->
                    <div class="form-check mb-4">
                        <input asp-for="RememberMe" class="form-check-input" id="rememberMeCheck" />
                        <label asp-for="RememberMe" class="form-check-label small text-muted" for="rememberMeCheck">Remember me</label>
                    </div>

                    <!-- Submit Button -->
                    <button type="submit" class="btn btn-dark-navy w-100 rounded-2 shadow-sm">
                        Log In
                    </button>
                </form>

                <!-- Divider -->
                <div class="divider-text">
                    <span>OR</span>
                </div>

                <!-- Footer Links -->
                <div class="text-center small">
                    <div class="mb-1">
                        <span class="text-muted">Trouble logging in?</span>
                        <a href="#" class="text-decoration-none fw-semibold text-dark ms-1">Reset Password</a>
                    </div>
                    <div>
                        <span class="text-muted">Need an account?</span>
                        <a href="#" class="text-decoration-none fw-semibold text-dark ms-1">Contact Admin to register</a>
                    </div>
                </div>

            </div>
        </div>

    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}