@{
    ViewData["Title"] = "Home Page";
}

<!-- Hero Section -->
<section class="py-5 text-center container">
    <div class="row py-lg-3 justify-content-center">
        <div class="col-lg-9 col-md-11">
            <h1 class="fw-bold text-dark display-5 mb-3">Welcome to ITI Project Portal</h1>
            <p class="fs-5 text-dark fw-semibold mb-2">
                Empowering Your Academic and Professional Journey
            </p>
            <p class="text-muted fs-6 mx-auto mb-4" style="max-width: 650px;">
                An integrated platform for students to manage products, explore categories, and build skills. Let's build your future together.
            </p>
        </div>
    </div>
</section>

<!-- Cards Section -->
<div class="container mb-5 pb-4">
    <div class="row g-4 justify-content-center">

        <!-- Card 1: Product Management -->
        <div class="col-md-5 col-lg-4">
            <div class="card h-100 border-0 shadow-sm rounded-4 text-center p-4">
                <div class="card-body d-flex flex-column align-items-center">
                    <div class="mb-3">
                        <img src="https://cdn-icons-png.flaticon.com/512/1087/1087815.png" alt="Product Management" class="img-fluid" style="width: 100px; height: 100px; object-fit: contain;">
                    </div>
                    <h4 class="card-title fw-bold text-dark mb-2">Product Management</h4>
                    <p class="card-text text-muted small mb-4">
                        Manage, track, and showcase your products effectively.
                    </p>
                    <a asp-controller="Product" asp-action="Index" class="btn btn-primary px-4 py-2 mt-auto rounded-3 fw-semibold">
                        Manage Products
                    </a>
                </div>
            </div>
        </div>

        <!-- Card 2: Category Management -->
        <div class="col-md-5 col-lg-4">
            <div class="card h-100 border-0 shadow-sm rounded-4 text-center p-4">
                <div class="card-body d-flex flex-column align-items-center">
                    <div class="mb-3">
                        <img src="https://cdn-icons-png.flaticon.com/512/3767/3767084.png" alt="Category Management" class="img-fluid" style="width: 100px; height: 100px; object-fit: contain;">
                    </div>
                    <h4 class="card-title fw-bold text-dark mb-2">Category Management</h4>
                    <p class="card-text text-muted small mb-4">
                        Organize and group your products into structured categories.
                    </p>
                    <a asp-controller="Category" asp-action="Index" class="btn btn-outline-secondary px-4 py-2 mt-auto rounded-3 fw-semibold">
                        Manage Categories
                    </a>
                </div>
            </div>
        </div>

    </div>
</div>